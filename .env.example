# -----------------------------------------------------------------------------
# Runtime (required): one active environment per process
# -----------------------------------------------------------------------------
APP_ENV=development

# Show only the temporary "Milevas" landing page on public routes.
# Set to true in the deployment environment to enable it; unset/false restores the site.
MILEVAS_LANDING_ONLY=false

# -----------------------------------------------------------------------------
# Database and file storage. pnpm setup fills this in.
#   local: Postgres in this project's Docker container, uploads in the project folder.
#   cloud: the Neon values below (or R2 for files). Switch any time and restart pnpm dev;
#          each database needs its tables once: pnpm db:migrate.
# -----------------------------------------------------------------------------
SERVICES=local

# local: Docker's port on this computer. pnpm setup picks a free one. The container and its data
# volume are named after the project folder unless COMPOSE_PROJECT_NAME is set.
POSTGRES_HOST_PORT=5434
# COMPOSE_PROJECT_NAME=

# cloud: paste the block Neon shows for a new project (Postgres and Storage) as it is.
# DATABASE_URL=
# DATABASE_URL_POOLED=
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=
# Cloudflare R2 instead of Neon for files: the same five storage names, with
# AWS_ENDPOINT_URL_S3=https://<account-id>.r2.cloudflarestorage.com and AWS_REGION=auto, plus the
# bucket's public address (its r2.dev URL or custom domain). Neon's is derived from the endpoint.
# S3_PUBLIC_URL=

# On Vercel, set the cloud values per environment: Preview -> a development branch or database,
# Production -> the production one.

# Local-only schema push (disposable local DB only)
PAYLOAD_LOCAL_PUSH=false

# Used by migrate scripts (see package.json db:migrate*)
# PAYLOAD_USE_DIRECT_DB=true

# Payload
PAYLOAD_SECRET=your-secret-here
PREVIEW_SECRET=your-preview-secret
# CRON_SECRET=your-cron-secret

# Mux, for the `videos` collection. On by default; it uploads once both tokens are set.
# false turns uploads off; the collection and saved videos stay.
# PAYLOAD_MUX_ENABLED=true
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# Optional: a Mux webhook to <site>/api/videos/mux-webhook signed with this secret keeps videos up
# to date when no editor has them open (Admin follows an upload by itself while it is open).
# MUX_WEBHOOK_SECRET=

# Hostname for next/image remotePatterns, if it differs from the public file address above.
# NEXT_PUBLIC_R2_IMAGE_HOSTNAME=

# Public site URL (SEO, sitemaps, previews)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional alias for Payload live preview; same origin as NEXT_PUBLIC_SITE_URL if both set.
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Configurator request notifications (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM=Milevas <noreply@example.com>
# CONFIGURATOR_SALES_EMAIL=sales@example.com

# Search indexing — requires explicit opt-in on production (see docs/PRODUCTION-INDEXING.md)
# ENABLE_SEARCH_INDEXING=false

# Remote cache revalidation when editing against a shared database from local admin
# PAYLOAD_REVALIDATE_REMOTE_URL=https://your-staging-or-prod-url.com

# -----------------------------------------------------------------------------
# Optional profile vars for DB copy / asset sync
# -----------------------------------------------------------------------------
# DATABASE_URI_DIRECT_STAGING=
# DATABASE_URI_DIRECT_PROD=

# S3-style names (or use R2_*_STAGING etc. — see scripts/sync-s3-assets.mjs)
# S3_BUCKET_STAGING=
# S3_ENDPOINT_STAGING=
# S3_REGION_STAGING=auto
# S3_ACCESS_KEY_ID_STAGING=
# S3_SECRET_ACCESS_KEY_STAGING=

# Editor assistant: the plugin has no provider or API key of its own; the model is created in
# src/payload/plugins/assistant-model.ts. pnpm setup fills these in. Server-only: never prefix
# them with NEXT_PUBLIC_.
# AI_PROVIDER=gateway            # gateway or off (deepseek still works for text, without images)
# AI_MODEL=openai/gpt-6-luna     # a gateway model that reads images
# AI_GATEWAY_API_KEY=            # not needed when deployed on Vercel

# MCP plugin (optional)
# Explicit false disables endpoints and hides API keys without removing their schema.
# PAYLOAD_MCP_ENABLED=true
# PAYLOAD_MCP_DISABLE_SSE=false

# Editor assistant debugging (server-only; includes conversation and content values).
# Enable on Vercel too, redeploy, then export locally with pnpm assistant:logs --deployment URL.
# DEBUG_ASSISTANT=true
# Optional persistent local JSONL sink; leave unset on Vercel.
# DEBUG_ASSISTANT_LOG_DIR=.assistant-debug
