# -----------------------------------------------------------------------------
# Runtime (required): one active environment per process
# -----------------------------------------------------------------------------
APP_ENV=development

# Database (preferred). The host port that the local Docker Postgres container
# is bound to (change this per-developer or per-project to avoid collisions).
POSTGRES_HOST_PORT=5434

# Database connection strings (keep the port in sync with POSTGRES_HOST_PORT above).
# Empty DB has no Payload tables until you run: pnpm setup:local  (or pnpm db:local:up then pnpm db:migrate).
# Migrations in this repo are a squashed baseline for fresh installs. If your database already ran an older migration chain from this boilerplate, reset the local Docker volume (or continue from your own migrations) instead of applying the squashed set on top.
# After migrate, the first app boot seeds published home + test pages (hero only) and a header "Test" nav link when there are no pages yet.
# Vercel recommendation: Preview -> staging/dev database, Production -> production database.
# Keep these unsuffixed runtime keys environment-specific in Vercel; do not point Preview and Production at the same DB unless that is intentional.
DATABASE_URI=postgresql://payload:payload@127.0.0.1:5434/payload_dev
DATABASE_URI_DIRECT=postgresql://payload:payload@127.0.0.1:5434/payload_dev

# Backward compatibility (optional if DATABASE_URI is set)
# DATABASE_URL=postgresql://payload:payload@127.0.0.1:5434/payload_dev

# Neon / managed Postgres often needs:
# DATABASE_SSL=true

# Local-only schema push (disposable local DB only)
PAYLOAD_LOCAL_PUSH=false

# Used by migrate scripts (see package.json db:migrate*)
# PAYLOAD_USE_DIRECT_DB=true

# Payload
PAYLOAD_SECRET=your-secret-here
PREVIEW_SECRET=your-preview-secret
# CRON_SECRET=your-cron-secret

# Mux (admin field + /api/mux/* routes)
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# Cloudflare R2 (S3-compatible) — Payload media when configured
# R2_BUCKET=
# R2_ENDPOINT=
# R2_REGION=auto
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Public base URL for uploaded files (required with the vars above for uploads + correct URLs)
# R2_PUBLIC_URL=https://your-account-id.r2.dev/your-bucket
# Hostname for next/image remotePatterns. Required at build time if you use R2 for media.
# Falls back to the hostname of R2_PUBLIC_URL when not set.
# NEXT_PUBLIC_R2_IMAGE_HOSTNAME=your-account-id.r2.dev

# Public site URL (SEO, sitemaps, previews)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional alias for Payload live preview; same origin as NEXT_PUBLIC_SITE_URL if both set.
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Configurator request notifications (Resend)
# RESEND_API_KEY=re_...
# RESEND_FROM=Milevas <noreply@example.com>
# CONFIGURATOR_SALES_EMAIL=sales@example.com

# Search indexing — requires explicit opt-in on production (see docs/PRODUCTION-INDEXING.md)
# ENABLE_SEARCH_INDEXING=false

# Remote cache revalidation when editing against a shared database from local admin
# PAYLOAD_REVALIDATE_REMOTE_URL=https://your-staging-or-prod-url.com

# -----------------------------------------------------------------------------
# Optional profile vars for DB copy / asset sync
# -----------------------------------------------------------------------------
# DATABASE_URI_DIRECT_STAGING=
# DATABASE_URI_DIRECT_PROD=

# S3-style names (or use R2_*_STAGING etc. — see scripts/sync-s3-assets.mjs)
# S3_BUCKET_STAGING=
# S3_ENDPOINT_STAGING=
# S3_REGION_STAGING=auto
# S3_ACCESS_KEY_ID_STAGING=
# S3_SECRET_ACCESS_KEY_STAGING=

# MCP plugin (optional)
# PAYLOAD_MCP_DISABLE_SSE=false
