{
  "name": "payload-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assistant:logs": "node ./scripts/assistant-logs.mjs",
    "assets:sync": "node ./scripts/sync-s3-assets.mjs",
    "assets:sync:prod-to-local": "node ./scripts/sync-s3-assets.mjs --from prod --to local",
    "assets:sync:staging-to-local": "node ./scripts/sync-s3-assets.mjs --from staging --to local",
    "assets:sync:prod-to-staging": "node ./scripts/sync-s3-assets.mjs --from prod --to staging",
    "assets:cors": "node ./scripts/set-bucket-cors.mjs",
    "build": "next build",
    "check": "biome check .",
    "check:write": "biome check . --write",
    "ci:build": "cross-env PAYLOAD_USE_DIRECT_DB=true NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload migrate && pnpm build",
    "db:local:up": "node ./scripts/db-local.mjs up",
    "db:local:down": "node ./scripts/db-local.mjs down",
    "db:local:reset": "node ./scripts/db-local.mjs reset",
    "setup:local": "node ./scripts/setup-local.mjs",
    "seed:configurator": "cross-env NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" tsx scripts/seed-configurator.ts",
    "setup": "node ./scripts/setup.mjs",
    "db:copy": "node ./scripts/copy-db-to-local.mjs",
    "db:copy:remote": "node ./scripts/copy-db-between-remote.mjs",
    "db:copy:prod-to-local": "node ./scripts/copy-db-to-local.mjs --from prod",
    "db:copy:prod-to-staging": "node ./scripts/copy-db-between-remote.mjs --from prod --to staging",
    "db:copy:staging-to-prod": "node ./scripts/copy-db-between-remote.mjs --from staging --to prod --force --confirm OVERWRITE_PROD",
    "db:copy:staging-to-local": "node ./scripts/copy-db-to-local.mjs --from staging",
    "db:migrate:create": "cross-env PAYLOAD_USE_DIRECT_DB=true NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload migrate:create",
    "db:migrate": "cross-env PAYLOAD_USE_DIRECT_DB=true NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload migrate",
    "db:migrate:status": "cross-env PAYLOAD_USE_DIRECT_DB=true NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload migrate:status",
    "cms:copy-global-locale": "cross-env NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" node ./scripts/run-copy-global-locale.mjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload generate:types",
    "db:copy:local-to-staging": "node ./scripts/copy-local-db-to-remote.mjs --to staging --confirm OVERWRITE_STAGING",
    "lint": "pnpm lint:biome && pnpm lint:eslint",
    "lint:biome": "biome lint .",
    "lint:eslint": "eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload generate:importmap",
    "payload:generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload generate:types",
    "payload:migrate": "cross-env NODE_OPTIONS=\"--no-deprecation --import ./scripts/register-style-imports-loader.mjs\" payload migrate",
    "quality": "pnpm check && pnpm typecheck && pnpm lint:eslint",
    "sl-create:api": "node ./sl-cli/create-api.mjs -a",
    "sl-create:block": "node ./sl-cli/create-block.mjs -b",
    "sl-create:component": "node ./sl-cli/create-component.mjs -c",
    "sl-create:context": "node ./sl-cli/create-context.mjs -x",
    "sl-create:collection": "node ./sl-cli/create-collection.mjs",
    "sl-create:global": "node ./sl-cli/create-global.mjs -g",
    "sl-create:util": "node ./sl-cli/create-util.mjs -u",
    "sl-create:field": "node ./sl-cli/create-field.mjs -f",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "tsx --test tests/*.test.mjs tests/*.test.mts",
    "test:example-blocks": "node --import ./scripts/register-style-imports-loader.mjs --import tsx tests/example-blocks.integration.ts",
    "test:slug-redirects": "node --import ./scripts/register-style-imports-loader.mjs --import tsx tests/slug-redirects.integration.ts",
    "test:setup-config": "node --import ./scripts/register-style-imports-loader.mjs --import tsx tests/setup-config.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.27",
    "@payloadcms/admin-bar": "^3.90.2",
    "@payloadcms/db-postgres": "^3.90.2",
    "@payloadcms/live-preview-react": "^3.90.2",
    "@payloadcms/next": "^3.90.2",
    "@payloadcms/plugin-mcp": "^3.90.2",
    "@payloadcms/plugin-redirects": "^3.90.2",
    "@payloadcms/plugin-seo": "^3.90.2",
    "@payloadcms/richtext-lexical": "^3.90.2",
    "@payloadcms/storage-s3": "^3.90.2",
    "@payloadcms/ui": "^3.90.2",
    "@simmalugnt-se/payload-content-health": "^0.9.0",
    "@simmalugnt-se/payload-editor-assistant": "^0.15.0",
    "@simmalugnt-se/payload-mux": "^0.1.1",
    "@simmalugnt-se/payload-visual-editing": "^0.3.2",
    "ai": "^7.0.60",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "next": "16.3.6",
    "next-intl": "^4.13.5",
    "next-sitemap": "^4.2.3",
    "payload": "^3.90.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@biomejs/biome": "2.4.15",
    "@clack/prompts": "^1.8.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
